# Server
NODE_ENV=development
PORT=5000
# Vite's dev server runs on 5173 by default — this MUST match wherever the
# frontend is actually running, or every API call from the browser will
# fail with a CORS error (which shows up as "Failed to fetch"). Comma-
# separate multiple origins if needed, e.g. for a deployed domain too:
# CLIENT_URL=http://localhost:5173,https://bolatemiglobal.com
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bolatemi?schema=public"

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_long_random_string

# Payments
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Email (order confirmations, quote notifications)
# Using Gmail SMTP with the business inbox. Gmail requires:
#   1. 2-Step Verification turned ON for this Google account
#   2. An App Password generated at myaccount.google.com/apppasswords
#      (NOT the normal Gmail login password — that will fail with
#      "Invalid login" since Google disabled plain-password SMTP access)
# Paste the 16-character App Password below, spaces removed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Bolatemiglobalandsonsenterprises@gmail.com
SMTP_PASS=your_16_char_app_password_here
SMTP_FROM="Bolatemi Global and Sons Enterprises <Bolatemiglobalandsonsenterprises@gmail.com>"

# WhatsApp business number (E.164, no +)
WHATSAPP_NUMBER=2348033345053

# File uploads (product images)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
